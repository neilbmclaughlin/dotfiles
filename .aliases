alias ls='ls -aFhlG'
alias vim=nvim
alias vi=nvim
alias ls-scripts='jq .scripts package.json'
alias jql='jq -C '.' | less -R'
alias node-grep='grep -R --exclude-dir={node_modules,.git,coverage} --include=\*.{js,json,nunjucks,njk,html}'
alias mux=tmuxinator
alias h-grep='history | grep'
alias ghvll='gh run view --log-failed $(gh run list --status failure --limit 1 --json databaseId | jq -r ".[] | .databaseId") | cat'
alias dcu='docker compose up --remove-orphans --build'
alias dcd='docker compose down'
alias dcr='docker compose restart'
alias qkill='ps -ef | grep "q chat" | grep -v grep | awk '"'"'{print $2, $8, $9, $10, $11}'"'"' | nl -w2 | while read line; do echo "$line"; done && echo "Enter the number(s) to kill (separated by space), or press Enter to cancel:" && read nums && if [ -n "$nums" ]; then for num in $nums; do pid=$(ps -ef | grep "q chat" | grep -v grep | awk '"'"'{print $2}'"'"' | sed -n "${num}p"); if [ -n "$pid" ]; then kill -9 $pid && echo "Force killed process $pid"; fi; done; fi'

alias q-chat-node='q chat --profile node-dev'
